holv 0

cap Out { print(s: String): Unit }

fn word(i: Int) -> String
  example word(1) == "1"
  example word(3) == "Fizz"
  example word(5) == "Buzz"
  example word(15) == "FizzBuzz"
{ if i mod 15 == 0 { "FizzBuzz" } else { if i mod 3 == 0 { "Fizz" } else { if i mod 5 == 0 { "Buzz" } else { str(i) } } } }

fn main(out: Out, n: Int) -> Int
  effects Out
{
  for i in 1 .. n + 1 { out.print(word(i)) }
  0
}
