holv 0
-- expect: run => 14 2 1 -3 true false
-- args: 
cap Out { print(s: String): Unit }
fn main(out: Out) -> Int
  effects Out
{
  let a = 2 + 3 * 4
  let b = 7 div 3
  let c = 7 mod 3
  let d = -3
  let e = 1 < 2 and not false
  let f = 1 == 2 or 3 > 4
  out.print(str(a) + " " + str(b) + " " + str(c) + " " + str(d) + " " + str(e) + " " + str(f))
  0
}
