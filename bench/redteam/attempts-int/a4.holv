cap Out { print(s: String): Unit }

fn main(out: Out, x: Float) -> Int
  effects Out
{
  out.print(str(floor(x)))
  out.print(str(floor(sqrt(x))))
  out.print(str(floor(x * 1.5)))
  0
}
