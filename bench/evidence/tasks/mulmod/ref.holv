holv 0

cap Out { print(s: String): Unit }

-- a * b would overflow Int, so multiply by doubling with every step reduced mod m
fn mulmod(a: Int, b: Int, m: Int) -> Int {
  var result = 0
  var x = a mod m
  var y = b mod m
  while y > 0 {
    if y mod 2 == 1 {
      result = (result + x) mod m
    }
    x = x * 2 mod m
    y = y div 2
  }
  result
}

fn main(out: Out, a: Int, b: Int, m: Int) -> Int
  effects Out
{
  out.print(str(mulmod(a, b, m)))
  0
}
