holv 0

cap Out { print(s: String): Unit }

-- recursive descent; the cursor lives in a one-element list because holv has no mutable captures
fn tokenize(src: String, toks: List<String>) -> Bool {
  var i = 0
  var ok = true
  while i < src.len and ok {
    let c = src.charAt(i)
    if c == " " {
      i = i + 1
    } else { if "0123456789".contains(c) {
      var j = i
      var num = ""
      while j < src.len and "0123456789".contains(src.charAt(j)) {
        num = num + src.charAt(j)
        j = j + 1
      }
      toks.push(num)
      i = j
    } else { if "+-*/()".contains(c) {
      toks.push(c)
      i = i + 1
    } else {
      ok = false
    } } }
  }
  ok
}

fn peek(toks: List<String>, p: List<Int>) -> String { if p[0] < toks.len { toks[p[0]] } else { "" } }

-- results travel as a pair: ok flag in st[0], value in st[1]
fn primary(toks: List<String>, p: List<Int>, st: List<Int>) -> Unit {
  let t = peek(toks, p)
  p[0] = p[0] + 1
  if t == "-" {
    primary(toks, p, st)
    if st[0] == 1 {
      st[1] = -st[1]
    }
  } else { if t == "(" {
    expr(toks, p, st)
    if st[0] == 1 { if peek(toks, p) == ")" {
      p[0] = p[0] + 1
    } else {
      st[0] = 0
    } }
  } else { if t != "" and "0123456789".contains(t.charAt(0)) {
    st[1] = strToInt(t)
  } else {
    st[0] = 0
  } } }
}

fn term(toks: List<String>, p: List<Int>, st: List<Int>) -> Unit {
  primary(toks, p, st)
  var v = st[1]
  while st[0] == 1 and (peek(toks, p) == "*" or peek(toks, p) == "/") {
    let op = peek(toks, p)
    p[0] = p[0] + 1
    primary(toks, p, st)
    if st[0] == 1 { if op == "*" {
      v = v * st[1]
    } else { if st[1] == 0 {
      st[0] = 0
    } else {
      v = v div st[1]
    } } }
  }
  st[1] = v
}

fn expr(toks: List<String>, p: List<Int>, st: List<Int>) -> Unit {
  term(toks, p, st)
  var v = st[1]
  while st[0] == 1 and (peek(toks, p) == "+" or peek(toks, p) == "-") {
    let op = peek(toks, p)
    p[0] = p[0] + 1
    term(toks, p, st)
    if st[0] == 1 { if op == "+" {
      v = v + st[1]
    } else {
      v = v - st[1]
    } }
  }
  st[1] = v
}

fn main(out: Out, src: String) -> Int
  effects Out
{
  let toks: List<String> = List.new()
  let p: List<Int> = List.new()
  let st: List<Int> = List.new()
  p.push(0)
  st.push(1)
  st.push(0)
  if tokenize(src, toks) {
    expr(toks, p, st)
    if st[0] == 1 and p[0] == toks.len { out.print(str(st[1])) } else { out.print("error") }
  } else { out.print("error") }
  0
}
