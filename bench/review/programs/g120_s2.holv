holv 0

cap Clock { now(): Int }
cap Store { get(k: String): Int }
cap Net { fetch(url: String): Int }
cap Out { print(s: String): Unit }

fn f0(x: Int) -> Int
{
  x + 1
}

fn f1(x: Int) -> Int
{
  x + 2 + f0(x)
}

fn f2(x: Int) -> Int
{
  x + 3 + f0(x) + f1(x)
