holv 0

fn peek(s: String, st: List<Int>) -> String
{
  while st[0] < s.len and s.charAt(st[0]) == " " {
    st[0] = st[0] + 1
  }
  if st[0] < s.len { s.charAt(st[0]) } else { "" }
}

fn digit(c: String) -> Int
{
  var d = -1
  for j in 0 .. 10 {
    if c == str(j) {
      d = j
    }
  }
  d
}

fn primary(s: String, st: List<Int>) -> Big
{
  let c = peek(s, st)
  var r = big(0)
  if c == "(" {
    st[0] = st[0] + 1
    r = expr(s, st)
    if peek(s, st) == ")" {
      st[0] = st[0] + 1
    } else {
      st[1] = 1
    }
  } else {
    if c != "" and digit(c) >= 0 {
      while st[0] < s.len and digit(s.charAt(st[0])) >= 0 {
        r = r * big(10) + big(digit(s.charAt(st[0])))
        st[0] = st[0] + 1
      }
    } else {
      st[1] = 1
    }
  }
  r
}

fn unary(s: String, st: List<Int>) -> Big
{
  if peek(s, st) == "-" {
    st[0] = st[0] + 1
    big(0) - unary(s, st)
  } else {
    primary(s, st)
  }
}

fn divT(a: Big, b: Big) -> Big
{
  let na = a < big(0)
  let nb = b < big(0)
  let aa = if na { big(0) - a } else { a }
  let bb = if nb { big(0) - b } else { b }
  let q = aa div bb
  if na != nb { big(0) - q } else { q }
}

fn term(s: String, st: List<Int>) -> Big
{
  var r = unary(s, st)
  var go = true
  while go and st[1] == 0 {
    let c = peek(s, st)
    if c == "*" {
      st[0] = st[0] + 1
      r = r * unary(s, st)
    } else {
      if c == "/" {
        st[0] = st[0] + 1
        let d = unary(s, st)
        if d == big(0) {
          st[1] = 1
        } else {
          r = divT(r, d)
        }
      } else {
        go = false
      }
    }
  }
  r
}

fn expr(s: String, st: List<Int>) -> Big
{
  var r = term(s, st)
  var go = true
  while go and st[1] == 0 {
    let c = peek(s, st)
    if c == "+" {
      st[0] = st[0] + 1
      r = r + term(s, st)
    } else {
      if c == "-" {
        st[0] = st[0] + 1
        r = r - term(s, st)
      } else {
        go = false
      }
    }
  }
  r
}

cap Out { print(s: String): Unit }

fn main(out: Out, s: String) -> Int
  effects Out
{
  let st: List<Int> = List.new()
  st.push(0)
  st.push(0)
  let r = expr(s, st)
  if st[1] == 0 and peek(s, st) == "" {
    out.print(str(r))
  } else {
    out.print("error")
  }
  0
}
